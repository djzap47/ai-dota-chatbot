{
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{app/**,scripts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
