# Copy the transaction pooler URL from Supabase; use the psycopg 3 driver.
# URL-encode special characters in the database password.
SUPABASE_DB_URL="postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
GOOGLE_API_KEY="your_google_gemini_api_key_here"
STRATZ_API_KEY="your_stratz_api_key_here"

# Chat settings (defaults from app/config.py). Choose a model your key can access.
GEMINI_MODEL="gemini-3.5-flash-lite"
CHATBOT_TEMPERATURE=0.7
# Use the same embedding model for ingestion and queries; rebuild after changes.
EMBEDDING_MODEL="gemini-embedding-2"
# Shared deployment-wide budget; concurrent limit is per worker process.
CHAT_REQUESTS_PER_MINUTE=30
CHAT_MAX_CONCURRENT=4
# Per-provider-request timeout in seconds; automatic chat retries are disabled.
UPSTREAM_TIMEOUT_SECONDS=20

# Set a random secret before deploying. When empty, maintenance routes return HTTP 503.
CRON_SECRET="replace_with_a_long_random_secret"

# Uvicorn's local port is set with --port; this field is available to configuration.
PORT=8000
